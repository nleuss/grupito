<?xml version="1.0" encoding="UTF-8"?>
<tt:tt xmlns:tt="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en">
  <tt:body><tt:div>
      <tt:p begin="00:00:01.000" end="00:00:03.500">Hello there, how are you today?</tt:p>
      <tt:p begin="00:00:04.000" end="00:00:06.500">I am learning Spanish with movies.</tt:p>
      <tt:p begin="00:00:07.000" end="00:00:09.500">The weather is beautiful this morning.</tt:p>
      <tt:p begin="00:00:10.000" end="00:00:12.500">Would you like a cup of coffee?</tt:p>
      <tt:p begin="00:00:13.000" end="00:00:15.500">Let&apos;s go to the beach tomorrow.</tt:p>
      <tt:p begin="00:00:16.000" end="00:00:18.500">I don&apos;t understand this word.</tt:p>
      <tt:p begin="00:00:19.000" end="00:00:21.500">Can you speak more slowly, please?</tt:p>
      <tt:p begin="00:00:22.000" end="00:00:24.500">Thank you very much for your help.</tt:p>
      <tt:p begin="00:00:25.000" end="00:00:27.500">See you later, my friend.</tt:p>
  </tt:div></tt:body>
</tt:tt>
